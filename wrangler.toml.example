name = "nfc-tag-tracker"
main = "src/index.ts"
compatibility_date = "2025-12-20"
account_id = "YOUR_CLOUDFLARE_ACCOUNT_ID"

[observability]
enabled = true

# Static assets configuration
[assets]
directory = "./public"

# D1 Database binding
[[d1_databases]]
binding = "DB"
database_name = "findmy_tags"
database_id = "YOUR_D1_DATABASE_ID"
migrations_dir = "migrations"

# KV namespace binding
[[kv_namespaces]]
binding = "TAGS_KV"
id = "YOUR_KV_NAMESPACE_ID"

# Environment variables
[vars]
DOMAIN = "https://your-worker-name.your-account.workers.dev"
SESSION_DURATION_HOURS = "720"
MAGIC_LINK_EXPIRY_MINUTES = "15"

# Secrets (set via: wrangler secret put <NAME>)
# TELEGRAM_BOT_TOKEN
# JWT_SECRET
# MAGIC_LINK_SECRET
